# Backend: passar este arquivo explicitamente ao Uvicorn com --env-file.
EMPORIO_AMBIENTE=desenvolvimento
EMPORIO_ORIGENS_CORS=["http://localhost:5173","http://127.0.0.1:5173"]
# Caminhos relativos são resolvidos a partir da raiz do projeto.
# O importador usa o ambiente do processo ou flags; não lê .env automaticamente.
EMPORIO_DIRETORIO_DADOS=data
EMPORIO_CAMINHO_BANCO=.local/emporio.sqlite3
# Índice documental separado; comandos locais usam ambiente ou flags.
EMPORIO_CAMINHO_PDF_POLITICAS=data/políticas_da_loja.pdf
EMPORIO_CAMINHO_INDICE_POLITICAS=.local/politicas.sqlite3
EMPORIO_TAMANHO_MAXIMO_TRECHO=1200
# Agente local: a CLI lê ambiente do processo, sem carregar .env automaticamente.
EMPORIO_OLLAMA_URL=http://127.0.0.1:11434
EMPORIO_OLLAMA_MODELO=qwen3:4b
EMPORIO_OLLAMA_TIMEOUT=60
EMPORIO_OLLAMA_TEMPERATURA=0
EMPORIO_OLLAMA_TOKENS=512
EMPORIO_OLLAMA_CONTEXTO_TOKENS=8192
EMPORIO_AGENTE_MAXIMO_ETAPAS=4
EMPORIO_AGENTE_MAXIMO_CHAMADAS=6
EMPORIO_AGENTE_MAXIMO_RESULTADOS=3
EMPORIO_AGENTE_MAXIMO_PERGUNTA=1000
EMPORIO_AGENTE_CONTEXTO_BYTES=6000
EMPORIO_AGENTE_RESPOSTA_BYTES=65536
EMPORIO_AGENTE_TIMEOUT_FERRAMENTA=10
EMPORIO_AGENTE_TIMEOUT_TOTAL=120
# Atendimento anônimo local: ausente/vazio impede publicação de evidências.
EMPORIO_CAMINHO_PUBLICACAO=.local/publicacao.json
EMPORIO_ATENDIMENTO_REQUISICOES_MINUTO=20
EMPORIO_ATENDIMENTO_CONCORRENCIA=1
EMPORIO_ATENDIMENTO_CORPO_BYTES=8192
EMPORIO_ATENDIMENTO_LEITURA_TIMEOUT=10
EMPORIO_ATENDIMENTO_DISPONIBILIDADE_TIMEOUT=5
